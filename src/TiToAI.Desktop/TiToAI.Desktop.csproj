<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TiToAI.Contracts\TiToAI.Contracts.csproj" />
    <ProjectReference Include="..\TiToAI.Infrastructure\TiToAI.Infrastructure.csproj" />
    <ProjectReference Include="..\TiToAI.Application\TiToAI.Application.csproj" />
    <ProjectReference Include="..\TiToAI.Browser\TiToAI.Browser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Target Name="BuildWebUi" BeforeTargets="CoreCompile">
    <Exec Command="pnpm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\TiToAI.Web" />
  </Target>

  <Target Name="CopyWebUi" AfterTargets="Build">
    <ItemGroup>
      <WebUiFile Include="$(MSBuildProjectDirectory)\..\TiToAI.Web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiFile)" DestinationFiles="@(WebUiFile->'$(TargetDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishWebUi" AfterTargets="Publish">
    <ItemGroup>
      <WebUiPublishFile Include="$(MSBuildProjectDirectory)\..\TiToAI.Web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiPublishFile)" DestinationFiles="@(WebUiPublishFile->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
