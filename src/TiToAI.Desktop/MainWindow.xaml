<Window x:Class="TiToAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:TiToAI.Desktop"
        mc:Ignorable="d"
        Title="TiToAI" Height="960" Width="1560" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">
    <Grid x:Name="RootGrid">
        <wv2:WebView2 x:Name="WebViewControl" />

        <Border x:Name="ErrorOverlay"
                Visibility="Collapsed"
                Background="#0B1220"
                Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                <TextBlock Text="Không thể khởi tạo WebView2"
                           Foreground="#F4F7FC"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorMessageText"
                           Foreground="#A9B8CD"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,24" />
                <Button x:Name="RetryButton"
                        Content="Thử lại"
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        Background="#6D3AF2"
                        Foreground="#F4F7FC"
                        BorderThickness="0"
                        Click="RetryButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
